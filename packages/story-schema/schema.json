{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TAKA Story Pack",
  "description": "塔卡故事包格式 v1：播放器引擎与内容解耦的契约。story.json 必须满足本 schema；此外 validate_story.py 做结构性检查（分支闭合、可达性、音频覆盖）。",
  "type": "object",
  "required": ["id", "title", "version", "startScene", "restartScene", "depletedScene", "speakers", "achievements", "scenes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "startScene": { "type": "string", "description": "首次进入的场景（通常是 prologue）" },
    "restartScene": { "type": "string", "description": "「重新开始故事」的目标场景；进入时电量回满" },
    "depletedScene": { "type": "string", "description": "非结局场景电量耗尽时的被动结局（通常 setBattery=0 的场景）" },
    "speakers": {
      "type": "object",
      "description": "台词归属表：角色中文名 → 声线 id（tts 管线与浏览器 TTS 共用）",
      "additionalProperties": { "type": "string" }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "icon", "desc", "unlockScene"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "icon": { "type": "string" },
          "desc": { "type": "string" },
          "unlockScene": { "type": "string", "description": "进入该场景即幂等解锁" }
        }
      }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/definitions/scene" }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "mode": { "enum": ["swim", "land"], "description": "立绘模式：水下收腿悬浮 / 陆地伸腿站立" },
        "text": { "type": "string", "description": "内置定稿正文；ai 场景作为回退文案" },
        "cost": { "type": "integer", "minimum": 0, "description": "进入本场景耗电量（缺省引擎按 10 计）" },
        "sun": { "type": "integer", "minimum": 0, "description": "太阳事件回电（先扣后回，救不了已耗尽）" },
        "setBattery": { "type": "integer", "minimum": 0, "maximum": 100, "description": "结局场景强制电量；非结局场景耗尽会强制结局" },
        "eyeState": { "enum": ["st-standby", "st-thinking", "st-listening", "st-low", "st-off"] },
        "endState": { "enum": ["st-off"], "description": "正文播完后的终态（如结局 B 关机）" },
        "ai": { "type": "boolean", "description": "中段场景标记：自由输入时允许现场生成（v1 内置路径不调 LLM）" },
        "beats": {
          "type": "array",
          "items": { "type": "string" },
          "description": "AI 填空的剧情要点；ai=true 时必填"
        },
        "freeInput": { "type": "boolean", "description": "是否提供选项 C 自由输入" },
        "isSpecialListen": { "type": "boolean", "description": "且听风吟场景：风声 BGM + 聆听进度条" },
        "next": { "type": "string", "description": "无选项场景（聆听条结束）的后续场景" },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "next"],
            "properties": {
              "text": { "type": "string" },
              "next": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
