{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TAKA Story Pack",
  "description": "塔卡故事包格式 v1：播放器引擎与内容解耦的契约。story.json 必须满足本 schema；此外 validate_story.py 做结构性检查（分支闭合、可达性、音频覆盖）。",
  "type": "object",
  "required": [
    "id",
    "title",
    "version",
    "startScene",
    "restartScene",
    "depletedScene",
    "speakers",
    "achievements",
    "scenes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "startScene": {
      "type": "string",
      "description": "首次进入的场景（通常是 prologue）"
    },
    "restartScene": {
      "type": "string",
      "description": "「重新开始故事」的目标场景；进入时电量回满"
    },
    "depletedScene": {
      "type": "string",
      "description": "非结局场景电量耗尽时的被动结局（通常 setBattery=0 的场景）"
    },
    "speakers": {
      "type": "object",
      "description": "台词归属表：角色中文名 → 声线 id（tts 管线与浏览器 TTS 共用）",
      "additionalProperties": {
        "type": "string"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "icon",
          "desc",
          "unlockScene"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "desc": {
            "type": "string"
          },
          "unlockScene": {
            "type": "string",
            "description": "进入该场景即幂等解锁"
          }
        }
      }
    },
    "scenes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/scene"
      }
    },
    "cover": {
      "type": "string",
      "description": "书架封面图（相对故事包根，可选）"
    },
    "summary": {
      "type": "string",
      "description": "书架一句话简介（可选）"
    },
    "ttsAliases": {
      "type": "object",
      "description": "读音别名（可选）：显示文本不动，只改喂给 TTS 的文案，如 {\"757\": \"七五七\"}"
    },
    "characters": {
      "type": "object",
      "description": "绘本模式角色 SVG 注册表（可选）：actor 名 → 相对故事包根的 SVG 路径，如 {\"seagull\": \"characters/seagull.svg\"}"
    },
    "mechanics": {
      "type": "object",
      "description": "包级玩法声明表（2026-10-03 组件化）：声明 id → { type: 组件注册名, ...参数 }；场景用 mechanic 字段引用。新玩法 = 这里加一条声明 + 播放器 mechanics/ 注册一个组件 + 校验器补结构检查",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "description": "组件注册名（apps/player/src/mechanics/registry.ts）；当前已知：collect"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "description": "collect：可交互收集物（塔卡贴近玻璃扫描收集）",
            "items": {
              "type": "object",
              "required": ["id", "actor", "x", "y"],
              "properties": {
                "id": { "type": "string", "description": "收集物唯一 id（去重用）" },
                "actor": { "type": "string", "description": "物化件：pack.characters 注册名或内置件（grass/cat/bee/butterfly 等）" },
                "x": { "type": "number", "description": "左页内横向位置 %" },
                "y": { "type": "number", "description": "左页内纵向位置 %" },
                "size": { "type": "number", "description": "宽度占左页 %（缺省 16）" },
                "label": { "type": "string", "description": "收集揭晓文案（如「拍打墙壁的猫猫」；收集前显示？？？）" }
              }
            }
          },
          "required": { "type": "integer", "minimum": 1, "description": "collect：集满多少个触发成就/继续" },
          "achievement": { "type": "string", "description": "collect：录满 required 时解锁的成就 id（须在根 achievements 表）" },
          "next": { "type": "string", "description": "collect：集满后跳转的目标场景" },
          "takaSkin": { "type": "string", "description": "collect：塔卡换装件（loadActor 两级解析：包 characters 注册 > 引擎内置件；缺省不换装，ch04 = pixel-taka）" },
          "bounds": {
            "type": "object",
            "description": "collect：禁入区椭圆（拱门/玻璃罩同源，页面 % 坐标；缺省 = ch04 拱门 50/90/45/70）",
            "properties": {
              "cx": { "type": "number" },
              "cy": { "type": "number" },
              "rx": { "type": "number" },
              "ry": { "type": "number" }
            }
          },
          "bypass": {
            "type": "array",
            "description": "collect：长途游动绕行点 [x,y]（页 %；路径不穿禁入区；缺省 = ch04 三点）",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "glass": { "type": "boolean", "description": "collect：禁入区玻璃罩光学处理（缺省不画）" }
        }
      }
    }
  },
  "definitions": {
    "scene": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "mode": {
          "enum": [
            "swim",
            "land"
          ],
          "description": "立绘模式：水下收腿悬浮 / 陆地伸腿站立"
        },
        "text": {
          "type": "string",
          "description": "内置定稿正文；ai 场景作为回退文案"
        },
        "background": {
          "type": "string",
          "description": "场景背景图（相对故事包根，如 backgrounds/xxx.jpg）；缺省保持上一场景"
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "description": "进入本场景耗电量（缺省引擎按 10 计）"
        },
        "sun": {
          "type": "integer",
          "minimum": 0,
          "description": "太阳事件回电（先扣后回，救不了已耗尽）"
        },
        "setBattery": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "结局场景强制电量；非结局场景耗尽会强制结局"
        },
        "eyeState": {
          "enum": [
            "st-standby",
            "st-thinking",
            "st-listening",
            "st-low",
            "st-off"
          ]
        },
        "endState": {
          "enum": [
            "st-off"
          ],
          "description": "正文播完后的终态（如结局 B 关机）"
        },
        "ai": {
          "type": "boolean",
          "description": "中段场景标记：自由输入时允许现场生成（v1 内置路径不调 LLM）"
        },
        "beats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "AI 填空的剧情要点；ai=true 时必填"
        },
        "freeInput": {
          "type": "boolean",
          "description": "是否提供选项 C 自由输入"
        },
        "freeInputNext": {
          "type": "string",
          "description": "自由输入（选项 C）生成后的跳转目标场景；优先于 choices[0].next / scene.next。第四章用于「自由输入统跳 E」"
        },
        "isSpecialListen": {
          "type": "boolean",
          "description": "且听风吟场景：风声 BGM + 聆听进度条"
        },
        "listenLabel": {
          "type": "string",
          "description": "isSpecialListen 场景聆听条结束按钮文案（不含省略号，引擎展示时补）；渲染为该场景的选项音频"
        },
        "next": {
          "type": "string",
          "description": "无选项场景（聆听条结束）的后续场景"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "next"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "next": {
                "type": "string"
              }
            }
          }
        },
        "ending": {
          "type": "boolean",
          "description": "结局标记（不动电量版）：会话收尾 + 回到书架；setBattery 场景天然是结局"
        },
        "voiceOverrides": {
          "type": "object",
          "description": "场景级声线覆盖：{角色名: 声线id}，只改朗读者不改显示文本（如结局声音转变 {\"小钉\": \"rivet-calm\"}）"
        },
        "freeInputMaxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "该场景自由输入（选项 C）的字数上限，默认 300；个别场景可收紧"
        },
        "stayFallback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "nonsense 原地停留的内置等待文案（轮换用，可选；缺省用服务端全局文案）。连续 nonsense 第 3 次起不再调 LLM，直接从这里取"
        },
        "outputMaxLength": {
          "type": "integer",
          "minimum": 50,
          "maximum": 800,
          "description": "该场景 AI 生成正文的字数硬上限（默认取 redlines.max_length=300）；对话密集型场景可放宽，如 ask-rivet=450"
        },
        "mechanic": {
          "type": "string",
          "description": "玩法声明引用（2026-10-03 组件化）：指向顶层 mechanics 表的声明 id（如第四章收集「farm-collect」）。带 mechanic 的场景由玩法组件接管整页，不应有 choices；声明缺失或类型未注册时引擎 fail-soft 退化普通书页"
        },
        "book": {
          "type": "object",
          "description": "横屏绘本模式构图（可选；缺省 = background 作左页画面 + 塔卡默认位 + 选项全退化气泡按钮）",
          "properties": {
            "art": {
              "type": "string",
              "description": "左页画面（相对故事包根）；缺省用 scene.background"
            },
            "taka": {
              "type": "object",
              "description": "塔卡在左页的位置（%，左上原点）与旋转角",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "rotate": { "type": "number" }
              }
            },
            "decor": {
              "type": "array",
              "items": { "enum": ["waves", "sun", "bubbles"] },
              "description": "左页氛围件（引擎内置 CSS 件）：waves 波纹 / sun 太阳 / bubbles 气泡"
            },
            "actors": {
              "type": "array",
              "description": "场景常驻角色（非交互演出件，2026-09-03）：随场景渲染即出现在左页画面；actor 须在 pack.characters 注册或为内置件（light/coral/deep/shell/sun/waves/screen/green/door）",
              "items": {
                "type": "object",
                "required": ["actor", "x", "y"],
                "properties": {
                  "actor": { "type": "string" },
                  "x": { "type": "number", "description": "左页内横向位置 %" },
                  "y": { "type": "number", "description": "左页内纵向位置 %" },
                  "size": { "type": "number", "description": "宽度占左页 %（缺省 20）" },
                  "flip": { "type": "boolean", "description": "水平镜像" },
                  "rotate": { "type": "number", "description": "旋转角（度）" }
                },
                "additionalProperties": false
              }
            },
            "hotspots": {
              "type": "array",
              "description": "选项物化：choice 下标对齐 choices；actor 须在 pack.characters 注册或为内置件（light/coral/deep/shell）；未声明的选项退化为右页气泡按钮",
              "items": {
                "type": "object",
                "required": ["choice", "actor", "x", "y"],
                "properties": {
                  "choice": { "type": "integer", "minimum": 0 },
                  "actor": { "type": "string" },
                  "x": { "type": "number", "description": "左页内横向位置 %" },
                  "y": { "type": "number", "description": "左页内纵向位置 %" },
                  "size": { "type": "number", "description": "宽度占左页 %（缺省 14）" }
                }
              }
            }
          }
        }
      }
    }
  }
}