{
 "prologue/01_narrator.mp3": {
  "hash": "f03854479df01101271a9aa546489a3449e5a624",
  "who": "narrator",
  "text": "这是塔卡。"
 },
 "prologue/02_narrator.mp3": {
  "hash": "b4431e59269ecc1f05801d97cfb1823fccf4d2e2",
  "who": "narrator",
  "text": "它住在海底。每天清理珊瑚，听老机器讲故事。"
 },
 "prologue/03_narrator.mp3": {
  "hash": "90e78fcb2e6320acb580877fc7535d191e98a012",
  "who": "narrator",
  "text": "塔卡是一只旧铁皮机器人，话少。"
 },
 "prologue/04_narrator.mp3": {
  "hash": "94e0d5a9df955eb1afdb3ded8dd264f99e05db7b",
  "who": "narrator",
  "text": "今天，它第一次想去海面上看看。"
 },
 "prologue/choices.mp3": {
  "hash": "11d43c18fe5e79e23c271f5010175cbc087d33bf",
  "who": "narrator",
  "text": "开始故事。"
 },
 "start/01_narrator.mp3": {
  "hash": "ac9d847824753aa7dcb9824fdcde8f9776ddf170",
  "who": "narrator",
  "text": "海底很亮。有很多光。"
 },
 "start/02_narrator.mp3": {
  "hash": "9e6935e595ee06ce52830be252b18aaa76053b2b",
  "who": "narrator",
  "text": "塔卡每天清理珊瑚。光在动。"
 },
 "start/03_narrator.mp3": {
  "hash": "5f9bc07fedda528299522f89f6439c4194229a77",
  "who": "narrator",
  "text": "它听到声音。呼呼。从上面来。"
 },
 "start/04_narrator.mp3": {
  "hash": "970d1585fc68c677782850dc8d480ee5e76a7da5",
  "who": "narrator",
  "text": "老机器说"
 },
 "start/05_oldmachine.mp3": {
  "hash": "8a6a95ca23d8a60f9918743dd2c813718f42b6ae",
  "who": "oldmachine",
  "text": "不要去。上面没有水。"
 },
 "start/06_narrator.mp3": {
  "hash": "693b58c0182bd375f8897d1eecea83a240b259d4",
  "who": "narrator",
  "text": "塔卡的灯闪了一下"
 },
 "start/07_taka.mp3": {
  "hash": "376e3457ce1dcc70ec86429724651df0599c2d7e",
  "who": "taka",
  "text": "我想知道。"
 },
 "start/choices.mp3": {
  "hash": "292f15dc8ec18c558f6d15944a4509a41903a485",
  "who": "narrator",
  "text": "你选。A. 游上去看看。B. 继续清理珊瑚。或者，说说你的想法。"
 },
 "clean_branch/01_narrator.mp3": {
  "hash": "c4c2a3a21a42e8fba187fb9c32e6bb9c4636b397",
  "who": "narrator",
  "text": "塔卡留下来清理珊瑚。"
 },
 "clean_branch/02_narrator.mp3": {
  "hash": "87fc3f1f108cf4ba17472fec3cbba37205504695",
  "who": "narrator",
  "text": "夜里，它的灯一直亮着。它睡不着。"
 },
 "clean_branch/03_narrator.mp3": {
  "hash": "0f1537ba2b05b9de933036a750c6364bc0fa92bd",
  "who": "narrator",
  "text": "呼呼。声音还在。"
 },
 "clean_branch/choices.mp3": {
  "hash": "94387f2b2f76e16d9d8e655077f2a095c5fb0249",
  "who": "narrator",
  "text": "A. 闭上眼睛睡觉。或者，说说你的想法。"
 },
 "dream/01_narrator.mp3": {
  "hash": "029157b5bc6a6e04ed30ec55d2ee7ed46ffe2fba",
  "who": "narrator",
  "text": "塔卡睡着了。"
 },
 "dream/02_narrator.mp3": {
  "hash": "e3bfa0cd99f35b0c255df2109ba80f18745f398b",
  "who": "narrator",
  "text": "它梦到光。很亮。很亮。"
 },
 "dream/03_narrator.mp3": {
  "hash": "9c24e1076a5332d9f70d73d17b1b65e0ac68f039",
  "who": "narrator",
  "text": "它梦到风。像海浪。呼呼。"
 },
 "dream/04_narrator.mp3": {
  "hash": "67270a3b45d2d843ed4aeb1ea16699cf2691c3fc",
  "who": "narrator",
  "text": "它梦到珊瑚。很大。不发光。"
 },
 "dream/05_narrator.mp3": {
  "hash": "9fb28e862edcbf49ea5417fdcb1f023c89aac7d4",
  "who": "narrator",
  "text": "老机器推它"
 },
 "dream/06_oldmachine.mp3": {
  "hash": "2034435480e0eb1d98ef3379b709e8750e39cb12",
  "who": "oldmachine",
  "text": "该工作了。"
 },
 "dream/07_narrator.mp3": {
  "hash": "989a721d0b65ab633c35d5537480f549e93d4cb7",
  "who": "narrator",
  "text": "塔卡看着珊瑚。又看了看上面。"
 },
 "dream/choices.mp3": {
  "hash": "7c8673e13a09b37ec76041bbbca8b7aed1795430",
  "who": "narrator",
  "text": "上去看看。或者，说说你的想法。"
 },
 "surface/01_narrator.mp3": {
  "hash": "f4b7c6d355afa3b70ab5eb9856b52bed28da964b",
  "who": "narrator",
  "text": "塔卡浮出水面。没有水。很疼。"
 },
 "surface/02_narrator.mp3": {
  "hash": "794298b65fdc4f38bbcea36746d43f10b6bb7694",
  "who": "narrator",
  "text": "但它听到了。风声。呼呼。"
 },
 "surface/03_narrator.mp3": {
  "hash": "debe142dd02887af31246ac9484249e70bb013f8",
  "who": "narrator",
  "text": "一只海鸥飞过来"
 },
 "surface/04_seagull.mp3": {
  "hash": "01bcbe1d0134f6f9cb3ca5f136e6876fe1dc1e42",
  "who": "seagull",
  "text": "你会掉下去。"
 },
 "surface/05_narrator.mp3": {
  "hash": "3068852a664bd2332a02fe1d6040d9bfbae2c884",
  "who": "narrator",
  "text": "塔卡说"
 },
 "surface/06_taka.mp3": {
  "hash": "c75d6dd513c95c042c6924b73d91a539327d0c48",
  "who": "taka",
  "text": "我在听。"
 },
 "surface/07_narrator.mp3": {
  "hash": "42ba83665d9ff49463acc2aef67d63d569f03369",
  "who": "narrator",
  "text": "海鸥说"
 },
 "surface/08_seagull.mp3": {
  "hash": "b52ebfa89ddb18bc2451a5115c8ca76e660868ed",
  "who": "seagull",
  "text": "听什么？"
 },
 "surface/09_narrator.mp3": {
  "hash": "3068852a664bd2332a02fe1d6040d9bfbae2c884",
  "who": "narrator",
  "text": "塔卡说"
 },
 "surface/10_taka.mp3": {
  "hash": "c3106441d629732db5598b52a4d560c64866d3ee",
  "who": "taka",
  "text": "我不知道。但我想听完。"
 },
 "surface/choices.mp3": {
  "hash": "103999f8991e3c4e42016e4ae5d1c61683fc3446",
  "who": "narrator",
  "text": "你选。A. 问风声：你从哪里来？。B. 只是听。或者，说说你的想法。"
 },
 "ask_wind/01_narrator.mp3": {
  "hash": "c403af7711a0266273492fe21363d9dffd383d05",
  "who": "narrator",
  "text": "塔卡问"
 },
 "ask_wind/02_taka.mp3": {
  "hash": "c155819dbc1a8c548fa804a527cd3efb7b6f8e43",
  "who": "taka",
  "text": "你从哪里来？"
 },
 "ask_wind/03_narrator.mp3": {
  "hash": "3a1f4edc5410571ecd16110efb4dbe0885b8e479",
  "who": "narrator",
  "text": "海鸥回答"
 },
 "ask_wind/04_seagull.mp3": {
  "hash": "e528c56339ac6997fa32605f21acf5b604e14399",
  "who": "seagull",
  "text": "我从有云的地方来。"
 },
 "ask_wind/05_narrator.mp3": {
  "hash": "c403af7711a0266273492fe21363d9dffd383d05",
  "who": "narrator",
  "text": "塔卡问"
 },
 "ask_wind/06_taka.mp3": {
  "hash": "9e07443f34cebe3d3c0aa031f72a3d00cac9df2c",
  "who": "taka",
  "text": "云是什么？"
 },
 "ask_wind/07_narrator.mp3": {
  "hash": "42ba83665d9ff49463acc2aef67d63d569f03369",
  "who": "narrator",
  "text": "海鸥说"
 },
 "ask_wind/08_seagull.mp3": {
  "hash": "a2aca1dc833c30a8ec1196b17ff028d48c225bfc",
  "who": "seagull",
  "text": "云是天上的海，只是它抓不住。"
 },
 "ask_wind/09_narrator.mp3": {
  "hash": "572167185eb8ad4ff624ae494bff250504e48d0d",
  "who": "narrator",
  "text": "太阳渐渐升起来了。"
 },
 "ask_wind/choices.mp3": {
  "hash": "114fee4475c60c7a02e2661ebd8a44f412009b50",
  "who": "narrator",
  "text": "继续。"
 },
 "just_listen/01_narrator.mp3": {
  "hash": "e24a505f268cf7397e1c06f7f56fc6d8f39a7eb5",
  "who": "narrator",
  "text": "塔卡没有说话。它的灯光慢慢变亮。"
 },
 "just_listen/02_narrator.mp3": {
  "hash": "db5d132b6109a1e815252c269f43883c8d450ecc",
  "who": "narrator",
  "text": "风声变得很清晰。呼呼。呼呼。"
 },
 "just_listen/03_narrator.mp3": {
  "hash": "c8f0cc76538c0960238811acb53f1fa1077bbd4c",
  "who": "narrator",
  "text": "没有问题。只有风。"
 },
 "just_listen/choices.mp3": {
  "hash": "cd1deb5b209e27c2f7508f3b58f3658baf54d671",
  "who": "narrator",
  "text": "睁开眼睛，太阳升起来了"
 },
 "climax/01_narrator.mp3": {
  "hash": "302cee3223d3e646003d4f683fa36e3449792898",
  "who": "narrator",
  "text": "太阳出来了。塔卡的电量不多了。"
 },
 "climax/02_narrator.mp3": {
  "hash": "e3a203aa5d44ec2fdca4972316250d2a9a7eb929",
  "who": "narrator",
  "text": "老机器的信号很弱"
 },
 "climax/03_oldmachine.mp3": {
  "hash": "a1a5dd0682d389defa9a9a059cd79896db6934d5",
  "who": "oldmachine",
  "text": "回来。现在。"
 },
 "climax/04_narrator.mp3": {
  "hash": "5d9505a0bbd184a02485d98d5cff925f9f52df2a",
  "who": "narrator",
  "text": "塔卡看着海面。风声还在。"
 },
 "climax/05_narrator.mp3": {
  "hash": "42ba83665d9ff49463acc2aef67d63d569f03369",
  "who": "narrator",
  "text": "海鸥说"
 },
 "climax/06_seagull.mp3": {
  "hash": "f13ba65eb0230b228484fde63e23b0a11535db5a",
  "who": "seagull",
  "text": "你选。我不帮你选。"
 },
 "climax/07_narrator.mp3": {
  "hash": "5ad2d817ee88b7b8b8feb97419146d5cbc3edfb4",
  "who": "narrator",
  "text": "塔卡的灯闪了三次。"
 },
 "climax/choices.mp3": {
  "hash": "7f5c815df605df46ac6f9ea6cfe1c5db362adf80",
  "who": "narrator",
  "text": "你选。A. 回海底充电。B. 再听一分钟。"
 },
 "ending_a/01_narrator.mp3": {
  "hash": "a6fe0dbb3ac15acf22859fff8a173f8291b21791",
  "who": "narrator",
  "text": "塔卡沉入海底。它接上了充电线。"
 },
 "ending_a/02_narrator.mp3": {
  "hash": "fba0ae4f559b89f777624b9fe673814637221a25",
  "who": "narrator",
  "text": "它把风声录进了记忆库。"
 },
 "ending_a/03_narrator.mp3": {
  "hash": "75fc1ae706fbc60409280016f9603f3d8216bb73",
  "who": "narrator",
  "text": "第二天，它带着满电回来，放给老机器听。"
 },
 "ending_a/04_narrator.mp3": {
  "hash": "3c5c0bb647d081fafc6fe8422de28c435e033b98",
  "who": "narrator",
  "text": "老机器的灯第一次闪了"
 },
 "ending_a/05_oldmachine.mp3": {
  "hash": "dd7d4eedc4481d55a70235d2978a7248a4ded050",
  "who": "oldmachine",
  "text": "原来是这样。"
 },
 "ending_a/choices.mp3": {
  "hash": "bedc2e24fac4e8b3411764db51b1c6bf7ecca7a0",
  "who": "narrator",
  "text": "重新开始故事。"
 },
 "ending_b/01_narrator.mp3": {
  "hash": "997d7608a6bdeae549abfa19fbdaef7cae5084bb",
  "who": "narrator",
  "text": "塔卡没有动。一分钟。两分钟。"
 },
 "ending_b/02_narrator.mp3": {
  "hash": "4897faea7d5d5f73885b02529125b4e80f4a2ed2",
  "who": "narrator",
  "text": "它听到了完整的一首歌。"
 },
 "ending_b/03_narrator.mp3": {
  "hash": "c5561be1fbfecf3dfcd0906c3c0857a83e626f4c",
  "who": "narrator",
  "text": "咔哒。塔卡关机了。"
 },
 "ending_b/04_narrator.mp3": {
  "hash": "f9a021005329003a17b7195577a42146449678b5",
  "who": "narrator",
  "text": "海鸥用巨大的翅膀，一点点把它推回了海面。"
 },
 "ending_b/05_narrator.mp3": {
  "hash": "ac911aebab5689c7fcf122cf4ae209309b4b2eb8",
  "who": "narrator",
  "text": "它在日落时醒来。电池 0%。但记忆里有完整的风声。"
 },
 "ending_b/06_narrator.mp3": {
  "hash": "3068852a664bd2332a02fe1d6040d9bfbae2c884",
  "who": "narrator",
  "text": "塔卡说"
 },
 "ending_b/07_taka.mp3": {
  "hash": "84d7d0e0ac2e5a3f949610017056288b0f1eb550",
  "who": "taka",
  "text": "值了。"
 },
 "ending_b/08_narrator.mp3": {
  "hash": "45e0d4f4d800891d5aeb2a5fe503d660ed826b4c",
  "who": "narrator",
  "text": "它身边坐着海鸥。"
 },
 "ending_b/choices.mp3": {
  "hash": "bedc2e24fac4e8b3411764db51b1c6bf7ecca7a0",
  "who": "narrator",
  "text": "重新开始故事。"
 },
 "codex/coral.science.mp3": {
  "hash": "c4cdad364462556c9919e414193c8f7660311972",
  "who": "narrator",
  "text": "珊瑚看起来像石头，其实是一大群小动物。每只小动物叫珊瑚虫，只有小芝麻那么大。珊瑚虫一代一代住在一起，盖出硬硬的房子。珊瑚礁是好多好多海洋动物的家。"
 },
 "codex/coral.taka.mp3": {
  "hash": "cd87d51482f39c234caf77facf1646355c8d87a4",
  "who": "taka",
  "text": "珊瑚不是石头。是很多小虫子盖的房子。 我每天打扫的，就是它们的家。"
 },
 "codex/seagull.science.mp3": {
  "hash": "89bc6d2d3fb5011c9e8dd8f3eaac2fa17b796cc6",
  "who": "narrator",
  "text": "海鸥是一种喜欢住在海边的鸟。它有一双大翅膀，可以迎着风飞很久。海鸥不挑食，鱼、小虾、贝壳，它都吃。它的叫声很响，「啊——啊——」，像在打招呼。"
 },
 "codex/seagull.taka.mp3": {
  "hash": "d19f9419fe945a2faeb8a561cc28fd3851f8b96b",
  "who": "taka",
  "text": "海鸥有翅膀。我没有。 但我有螺旋桨。"
 }
}