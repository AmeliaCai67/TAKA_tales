{
 "prologue/01_narrator.mp3": {
  "hash": "a368b72a0ef3e67052a016298eccfc118c638f69",
  "who": "narrator",
  "text": "这是塔卡。"
 },
 "prologue/02_narrator.mp3": {
  "hash": "50e5d7fb90639dfce901a53687d8f09283d7c9e0",
  "who": "narrator",
  "text": "它住在海底。每天清理珊瑚，听老机器讲故事。"
 },
 "prologue/03_narrator.mp3": {
  "hash": "40ee620875d2b27727adbe9db6a4700bf2492efb",
  "who": "narrator",
  "text": "塔卡是一只旧铁皮机器人，话少。"
 },
 "prologue/04_narrator.mp3": {
  "hash": "ffd2af7e2a74f6393a47a7a24fde5ccdd2bf31f4",
  "who": "narrator",
  "text": "今天，它第一次想去海面上看看。"
 },
 "prologue/choices.mp3": {
  "hash": "1ce1974209b2a4e9d5e370b0bdeac1bc58ed5ec4",
  "who": "narrator",
  "text": "开始故事。"
 },
 "start/01_narrator.mp3": {
  "hash": "66994f16df162204464942af703db52ed2503e28",
  "who": "narrator",
  "text": "海底很亮。有很多光。"
 },
 "start/02_narrator.mp3": {
  "hash": "d4fa1336eea4e3bded33f6f87217366ee8d65fd5",
  "who": "narrator",
  "text": "塔卡每天清理珊瑚。光在动。"
 },
 "start/03_narrator.mp3": {
  "hash": "9dd16847b16d26699af1690b5c57198cd3e43ecc",
  "who": "narrator",
  "text": "它听到声音。呼呼。从上面来。"
 },
 "start/04_narrator.mp3": {
  "hash": "bfbdc85c5ad70fa109b5faeed0e4da3deb36e7ec",
  "who": "narrator",
  "text": "老机器说"
 },
 "start/05_oldmachine.mp3": {
  "hash": "a5b54165276bb5c4969137c24241ab1a1251d6f2",
  "who": "oldmachine",
  "text": "不要去。上面没有水。"
 },
 "start/06_narrator.mp3": {
  "hash": "20e1f4218ff5a48c566f7203f6a4692de03e1bd7",
  "who": "narrator",
  "text": "塔卡的灯闪了一下"
 },
 "start/07_taka.mp3": {
  "hash": "bf632185c3e7fb09c6ca9d0f852f23a97f92f37e",
  "who": "taka",
  "text": "我想知道。"
 },
 "start/choices.mp3": {
  "hash": "38ec09c915499a358f6890c616a5e1aa4012291a",
  "who": "narrator",
  "text": "你选。A. 游上去看看。B. 继续清理珊瑚。或者，说说你的想法。"
 },
 "clean_branch/01_narrator.mp3": {
  "hash": "1cd805604b8530b96f95dc79f62ea7aa25a443e3",
  "who": "narrator",
  "text": "塔卡留下来清理珊瑚。"
 },
 "clean_branch/02_narrator.mp3": {
  "hash": "117586e661a159ae5da909ec4fd96351fb50ad82",
  "who": "narrator",
  "text": "夜里，它的灯一直亮着。它睡不着。"
 },
 "clean_branch/03_narrator.mp3": {
  "hash": "76c4453bc4ea68954dc21cb31b053d52cea2d319",
  "who": "narrator",
  "text": "呼呼。声音还在。"
 },
 "clean_branch/choices.mp3": {
  "hash": "98ac25b056f679a7ebcb2802de5b8c1f9d20a0fd",
  "who": "narrator",
  "text": "A. 闭上眼睛睡觉。或者，说说你的想法。"
 },
 "dream/01_narrator.mp3": {
  "hash": "ac33d5e577e8178eed505afcee0ccc7a4e28500b",
  "who": "narrator",
  "text": "塔卡睡着了。"
 },
 "dream/02_narrator.mp3": {
  "hash": "5e21817e1d58bd03655adc85d5c0636330336ed4",
  "who": "narrator",
  "text": "它梦到光。很亮。很亮。"
 },
 "dream/03_narrator.mp3": {
  "hash": "199bbad04bb362db330352b049dae5c32a4ec164",
  "who": "narrator",
  "text": "它梦到风。像海浪。呼呼。"
 },
 "dream/04_narrator.mp3": {
  "hash": "d4cc1784b22615ff71ef37831e43bf481e2779ec",
  "who": "narrator",
  "text": "它梦到珊瑚。很大。不发光。"
 },
 "dream/05_narrator.mp3": {
  "hash": "75469262b9cccf737899c8f7a28d6f021c892636",
  "who": "narrator",
  "text": "老机器推它"
 },
 "dream/06_oldmachine.mp3": {
  "hash": "7046456cdd006f834935aa4b2551c8886ce54e28",
  "who": "oldmachine",
  "text": "该工作了。"
 },
 "dream/07_narrator.mp3": {
  "hash": "2bb863459e40ed26fb84fd061c68d752e62caa8a",
  "who": "narrator",
  "text": "塔卡看着珊瑚。又看了看上面。"
 },
 "dream/choices.mp3": {
  "hash": "9a8a036d88c418a5f986a26e28b047b6b8706899",
  "who": "narrator",
  "text": "上去看看。或者，说说你的想法。"
 },
 "surface/01_narrator.mp3": {
  "hash": "6172ffe11b43110c273dcb8b9c27a30d70da4617",
  "who": "narrator",
  "text": "塔卡浮出水面。没有水。很疼。"
 },
 "surface/02_narrator.mp3": {
  "hash": "55cffdb27fce879851481b8448bedc3c53035dd9",
  "who": "narrator",
  "text": "但它听到了。风声。呼呼。"
 },
 "surface/03_narrator.mp3": {
  "hash": "d923a6afcf53ab03d9869e9fa4123e9a35ea8b45",
  "who": "narrator",
  "text": "一只海鸥飞过来"
 },
 "surface/04_seagull.mp3": {
  "hash": "31256a53176ee21a2d63828ed05576dd161c9174",
  "who": "seagull",
  "text": "你会掉下去。"
 },
 "surface/05_narrator.mp3": {
  "hash": "9c2c3985ae2af20ebc4cf4e1081dd1c6a8eacc59",
  "who": "narrator",
  "text": "塔卡说"
 },
 "surface/06_taka.mp3": {
  "hash": "64499bd25fb1c76c77688ea677bc25a327998720",
  "who": "taka",
  "text": "我在听。"
 },
 "surface/07_narrator.mp3": {
  "hash": "ab19d72fbb894f8f08173864b17297e12d50e411",
  "who": "narrator",
  "text": "海鸥说"
 },
 "surface/08_seagull.mp3": {
  "hash": "d08826fb7984202263e4ab90f09d19bdd28e4ef7",
  "who": "seagull",
  "text": "听什么？"
 },
 "surface/09_narrator.mp3": {
  "hash": "9c2c3985ae2af20ebc4cf4e1081dd1c6a8eacc59",
  "who": "narrator",
  "text": "塔卡说"
 },
 "surface/10_taka.mp3": {
  "hash": "7377c708e1d7793e65dacc20d5e22d610b900992",
  "who": "taka",
  "text": "我不知道。但我想听完。"
 },
 "surface/choices.mp3": {
  "hash": "2a8a10021214fcb13d35b63d5d6ff63029722c9e",
  "who": "narrator",
  "text": "你选。A. 问风声：你从哪里来？。B. 只是听。或者，说说你的想法。"
 },
 "ask_wind/01_narrator.mp3": {
  "hash": "36cae41f1eafedf374f0dd7d9904f3f54772862f",
  "who": "narrator",
  "text": "塔卡问"
 },
 "ask_wind/02_taka.mp3": {
  "hash": "736434be1de261bed7d9c49a5a4d6160cf3caaf1",
  "who": "taka",
  "text": "你从哪里来？"
 },
 "ask_wind/03_narrator.mp3": {
  "hash": "60c72a61b2203df92da88b6614851fc8f6f6d151",
  "who": "narrator",
  "text": "海鸥回答"
 },
 "ask_wind/04_seagull.mp3": {
  "hash": "14cefd4bb63fe5c49e6076b2b7edca6dc11cc1f9",
  "who": "seagull",
  "text": "我从有云的地方来。"
 },
 "ask_wind/05_narrator.mp3": {
  "hash": "36cae41f1eafedf374f0dd7d9904f3f54772862f",
  "who": "narrator",
  "text": "塔卡问"
 },
 "ask_wind/06_taka.mp3": {
  "hash": "93f56041a45246cf2f83131564adb9b4d06e79d6",
  "who": "taka",
  "text": "云是什么？"
 },
 "ask_wind/07_narrator.mp3": {
  "hash": "ab19d72fbb894f8f08173864b17297e12d50e411",
  "who": "narrator",
  "text": "海鸥说"
 },
 "ask_wind/08_seagull.mp3": {
  "hash": "c52660b6734fb2030a3d2857b6ed71f8a4cc1d66",
  "who": "seagull",
  "text": "云是天上的海，只是它抓不住。"
 },
 "ask_wind/09_narrator.mp3": {
  "hash": "5c142f76d51a4f3e0e35dde429c93b0058586107",
  "who": "narrator",
  "text": "太阳渐渐升起来了。"
 },
 "ask_wind/choices.mp3": {
  "hash": "af379e32ebac34c464ccde3124ca49674a789c1b",
  "who": "narrator",
  "text": "继续。"
 },
 "just_listen/01_narrator.mp3": {
  "hash": "ed9318dc1522fd6a1de2b77f5431e5a202535933",
  "who": "narrator",
  "text": "塔卡没有说话。它的灯光慢慢变亮。"
 },
 "just_listen/02_narrator.mp3": {
  "hash": "b10f3e7200746e1ac5c7354487ab4e92c04c0d84",
  "who": "narrator",
  "text": "风声变得很清晰。呼呼。呼呼。"
 },
 "just_listen/03_narrator.mp3": {
  "hash": "864b33e463ee7634c9e8a7a241a007ba557f1439",
  "who": "narrator",
  "text": "没有问题。只有风。"
 },
 "just_listen/choices.mp3": {
  "hash": "68d2940fafe67fb17e9245b0f2496d782e79dd26",
  "who": "narrator",
  "text": "睁开眼睛，太阳升起来了"
 },
 "climax/01_narrator.mp3": {
  "hash": "c112014de80911a5b08b9d30a6eb72bfaff64485",
  "who": "narrator",
  "text": "太阳出来了。塔卡的电量不多了。"
 },
 "climax/02_narrator.mp3": {
  "hash": "fb6279e99c694bf37ccdc28a5b0894ec78b2ae37",
  "who": "narrator",
  "text": "老机器的信号很弱"
 },
 "climax/03_oldmachine.mp3": {
  "hash": "ffa9148f626eba094a8f85a4a43509f19f3e841b",
  "who": "oldmachine",
  "text": "回来。现在。"
 },
 "climax/04_narrator.mp3": {
  "hash": "1f2973b6ac45929946650f7ef0828de6293b9079",
  "who": "narrator",
  "text": "塔卡看着海面。风声还在。"
 },
 "climax/05_narrator.mp3": {
  "hash": "ab19d72fbb894f8f08173864b17297e12d50e411",
  "who": "narrator",
  "text": "海鸥说"
 },
 "climax/06_seagull.mp3": {
  "hash": "af94ee1b47a33cb00c9e55ec84d011480fe24753",
  "who": "seagull",
  "text": "你选。我不帮你选。"
 },
 "climax/07_narrator.mp3": {
  "hash": "931f4b8a5a33286ac2b5b8b94f9232671803648d",
  "who": "narrator",
  "text": "塔卡的灯闪了三次。"
 },
 "climax/choices.mp3": {
  "hash": "5f0868820518628500b243c05dd6e3b049c1c602",
  "who": "narrator",
  "text": "你选。A. 回海底充电。B. 再听一分钟。"
 },
 "ending_a/01_narrator.mp3": {
  "hash": "8e8dced57a2b30f378e7fd7db43af5b37bad2e14",
  "who": "narrator",
  "text": "塔卡沉入海底。它接上了充电线。"
 },
 "ending_a/02_narrator.mp3": {
  "hash": "960698b791fab6ccc910aadfc4f94be9776abed0",
  "who": "narrator",
  "text": "它把风声录进了记忆库。"
 },
 "ending_a/03_narrator.mp3": {
  "hash": "048c813f9ffb6b76bf83abced7a348826dc130a4",
  "who": "narrator",
  "text": "第二天，它带着满电回来，放给老机器听。"
 },
 "ending_a/04_narrator.mp3": {
  "hash": "d9f5019897261d55e05a6c6733ade9941f7c7c75",
  "who": "narrator",
  "text": "老机器的灯第一次闪了"
 },
 "ending_a/05_oldmachine.mp3": {
  "hash": "3bb80d5c054ff5aea354688cb23d134bd1989ab1",
  "who": "oldmachine",
  "text": "原来是这样。"
 },
 "ending_a/choices.mp3": {
  "hash": "a2c80552496f6e00dfeea43fc35737507a81c21e",
  "who": "narrator",
  "text": "重新开始故事。"
 },
 "ending_b/01_narrator.mp3": {
  "hash": "73f74624bbf9cc8c8a3212b35da81d6a2016a879",
  "who": "narrator",
  "text": "塔卡没有动。一分钟。两分钟。"
 },
 "ending_b/02_narrator.mp3": {
  "hash": "a8670afd27021886087de8e6d8993d6811b73ae2",
  "who": "narrator",
  "text": "它听到了完整的一首歌。"
 },
 "ending_b/03_narrator.mp3": {
  "hash": "9ff918f36c28ca84a9a4bbaf4a682b3c3748bbed",
  "who": "narrator",
  "text": "咔哒。塔卡关机了。"
 },
 "ending_b/04_narrator.mp3": {
  "hash": "27f8b4c2907f271f988ee08e343b351a050e39bb",
  "who": "narrator",
  "text": "海鸥用巨大的翅膀，一点点把它推回了海面。"
 },
 "ending_b/05_narrator.mp3": {
  "hash": "755bc859f0a9411b959e6f7597abb333a77464e9",
  "who": "narrator",
  "text": "它在日落时醒来。电池 0%。但记忆里有完整的风声。"
 },
 "ending_b/06_narrator.mp3": {
  "hash": "9c2c3985ae2af20ebc4cf4e1081dd1c6a8eacc59",
  "who": "narrator",
  "text": "塔卡说"
 },
 "ending_b/07_taka.mp3": {
  "hash": "3b12b589786e1cb7e4be48c7d4f64b55e5337144",
  "who": "taka",
  "text": "值了。"
 },
 "ending_b/08_narrator.mp3": {
  "hash": "70f4d8bf181fbe4312e866cbeb671949cc19b6b1",
  "who": "narrator",
  "text": "它身边坐着海鸥。"
 },
 "ending_b/choices.mp3": {
  "hash": "a2c80552496f6e00dfeea43fc35737507a81c21e",
  "who": "narrator",
  "text": "重新开始故事。"
 }
}